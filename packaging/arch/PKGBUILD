# Maintainer: ccampora <ccampora@gmail.com>
pkgname=py-onedrive
pkgver=0.1.1
pkgrel=1
pkgdesc="OneDrive Files On-Demand FUSE client for Linux"
arch=('any')
url="https://github.com/ccampora/py-onedrive"
license=('MIT')
depends=('python' 'python-requests' 'python-pyfuse3' 'python-trio' 'fuse3')
source=("$pkgname-$pkgver.tar.gz::https://github.com/ccampora/py-onedrive/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('0a435580c5da97c86dedcf992e260ab10f22f2fa49247771de6489842b8dd7b0')
install=py-onedrive.install

package() {
  cd "$srcdir/$pkgname-$pkgver"

  install -dm755 "$pkgdir/usr/lib/py-onedrive"
  install -Dm644 -t "$pkgdir/usr/lib/py-onedrive" ./*.py

  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/py-onedrive" << 'EOF'
#!/usr/bin/env bash
export PYTHONPATH=/usr/lib/py-onedrive
exec python3 /usr/lib/py-onedrive/mount.py "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/py-onedrive"

  install -Dm644 packaging/py-onedrive.service \
    "$pkgdir/usr/lib/systemd/user/py-onedrive.service"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
